# Copier vers .env et renseigner les valeurs. Ne commitez pas .env avec des secrets.

# --- Site (Vite) ---
VITE_PUBLIC_SITE_URL=https://votre-projet.vercel.app

# --- Supabase (client navigateur — préfixe VITE_) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon

# Clé service (scripts serveur / migrations locales uniquement — jamais dans le bundle Vite)
SUPABASE_SERVICE_ROLE_KEY=

# --- PostgreSQL (connexion directe pour scripts, ETL, jobs — hors navigateur) ---
# Exemple : base Supabase « Transaction » ou instance Postgres dédiée
POSTGRES_HOST=db.xxxx.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=postgres
POSTGRES_SSLMODE=require

# URL unique (alternative aux variables ci-dessus), pratique pour Prisma / Drizzle / psql
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@db.xxxx.supabase.co:5432/postgres?sslmode=require
